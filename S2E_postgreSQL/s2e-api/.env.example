# Chave secreta Flask — gere com: python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=substitua-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# String de conexão do Supabase — Transaction Pooler (porta 6543)
# Encontre em: Supabase Dashboard > Project > Settings > Database > Connection String
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Em produção, prefira verify-full com a CA fornecida pelo provedor.
DATABASE_SSLMODE=require

# Opcional: email para envio de links de recuperação de senha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Opcional
UPLOAD_FOLDER=storage
BASE_URL=https://seu-dominio.com
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
APP_ENV=development

# Diretório escolar por consultas SQL PostgreSQL fornecidas pelo TI.
# "off" bloqueia o portal dos responsáveis até a integração ser configurada.
# "demo" usa vínculos fictícios já cadastrados. Em site remoto, exige as
# marcações is_demo na conta e em TODOS os alunos vinculados, HTTPS e permissão explícita.
SCHOOL_DIRECTORY_MODE=off
SCHOOL_DEMO_EMAILS=
SCHOOL_DEMO_REMOTE_ALLOWED=false
# Quando SCHOOL_DIRECTORY_MODE=sql: usuário SOMENTE LEITURA no banco escolar,
# conexão diferente de DATABASE_URL e TLS com identidade verificada.
SCHOOL_SQL_DATABASE_URL=postgresql://usuario_leitura:senha@servidor-escolar:5432/banco
SCHOOL_SQL_SSLMODE=verify-full
# Diretório privado contendo responsavel.sql e filhos.sql aprovados pelo TI.
SCHOOL_SQL_QUERY_DIR=
