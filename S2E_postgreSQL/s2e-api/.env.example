# Chave secreta Flask — gere com: python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=substitua-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# String de conexão do Supabase — Transaction Pooler (porta 6543)
# Encontre em: Supabase Dashboard > Project > Settings > Database > Connection String
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Usadas apenas por setup_db.py ao criar o primeiro administrador.
INITIAL_ADMIN_PASSWORD=substitua-por-uma-senha-forte
INITIAL_ADMIN_EMAIL=admin@secureedu.com
# Necessária somente com `python setup_db.py --reset`; esse modo apaga todas as tabelas.
# CONFIRM_RESET_DATABASE=APAGAR-TODOS-OS-DADOS

PORT=8002
FLASK_DEBUG=false

# Conexões simultâneas por worker do gunicorn. O total contra o Supabase é
# DB_POOL_MAX x nº de workers — confira o limite do seu plano antes de aumentar.
DB_POOL_MAX=5

# ProxyFix: em produção atrás de um proxy (Render), deixe true para o rate limit enxergar o IP
# real do cliente via X-Forwarded-For. Coloque false se a app receber tráfego direto, senão o
# cliente pode forjar o próprio IP no cabeçalho.
TRUST_PROXY=true

# Limpeza/expiração periódica em thread de fundo (app/core/maintenance.py).
# Coloque false se preferir agendar apenas o cron externo: python manutencao.py
MANUTENCAO_AUTOMATICA=true
MANUTENCAO_INTERVALO_SEG=600
MANUTENCAO_DIAS_RETENCAO=30

# Quando o SMTP falha, o código de 2FA e os links de redefinição só vão para o log se esta
# variável for true. Serve para desenvolvimento sem e-mail configurado — NUNCA em produção: o
# log passaria a conter segundo fator válido e links de troca de senha prontos para uso.
MAILER_FALLBACK_LOG=false

# Opcional: email para envio de links de recuperação de senha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Opcional
UPLOAD_FOLDER=storage
MAX_CONTENT_LENGTH=16777216
BASE_URL=https://seu-dominio.com
FORCE_HTTPS=false

# SESSION_TIMEOUT foi removida daqui: ela era lida por app/config.py mas nenhum ponto do
# código usava o valor. Quem controla a sessão é app/__init__.py, com dois limites fixos:
# 30 minutos de inatividade (_SESSION_IDLE_MINUTES) e 8 horas de duração máxima
# (PERMANENT_SESSION_LIFETIME). Manter a variável aqui dava a impressão de que dava para
# ajustar o tempo de sessão pelo .env, e não dava.

# Banco SQL da escola (alimentado a partir do TOTVS, sem integração direta com o TOTVS).
# Fonte única de dados de aluno (RA, nome, foto, turma, série) e de validação de responsáveis
# no portal dos pais (autocadastro e login).
#
# Três modos:
#   1) SCHOOL_SQL_MOCK=true  -> 3 alunos fixos em Python, sem banco nenhum (padrão)
#   2) SCHOOL_SQL_MOCK=false + ENGINE=sqlite -> banco provisório local, com dados de exemplo.
#      Crie com: python escola_provisoria/seed.py   (ver escola_provisoria/README.md)
#   3) SCHOOL_SQL_MOCK=false + ENGINE=postgres -> banco real da escola, quando ela definir
#
# ATENÇÃO: a instituição ainda não definiu servidor/engine/schema do banco real. O schema do
# banco provisório (escola_provisoria/schema.sql) é a especificação do que ela precisa expor.
SCHOOL_SQL_MOCK=true
SCHOOL_SQL_ENGINE=sqlite
# Para sqlite: caminho do arquivo .db. Para postgres: nome do banco.
SCHOOL_SQL_DATABASE=../escola_provisoria/escola.db
SCHOOL_SQL_HOST=
SCHOOL_SQL_PORT=
SCHOOL_SQL_USER=
SCHOOL_SQL_PASSWORD=

# Fuso da escola. Servidor e Postgres rodam em UTC; pais e portaria usam o relogio local.
TIMEZONE=America/Sao_Paulo

# Segundos para abrir a conexao e para cada consulta no banco da escola. Sem isso, o banco
# fora do ar pendura a request ate o timeout de TCP do sistema (mais de um minuto).
SCHOOL_SQL_TIMEOUT_SEG=5
