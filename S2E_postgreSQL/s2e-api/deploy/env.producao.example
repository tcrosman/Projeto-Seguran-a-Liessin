# =============================================================================
# .env de PRODUCAO do SecureEdu — VPS Hostinger
#
# Copie para s2e-api/.env, preencha os <placeholders> e proteja o arquivo:
#   cp deploy/env.producao.example .env
#   chmod 600 .env
#   chown secureedu:secureedu .env
#
# REGRA DE FORMATO — vale a pena ler antes de editar:
# este arquivo e lido por DOIS interpretadores diferentes: o python-dotenv da
# aplicacao e o EnvironmentFile= do systemd. O systemd NAO remove comentario no fim
# da linha de um valor. Ou seja:
#
#     FORCE_HTTPS=true   # ligar em producao      <-- ERRADO: o valor vira
#                                                     "true   # ligar em producao"
#     FORCE_HTTPS=true                            <-- certo
#
# Comentarios sempre em linha propria. Valores com espaco, "#" ou aspas devem vir
# entre aspas duplas (os dois interpretadores removem as aspas do mesmo jeito).
# =============================================================================


# --- Identidade da instalacao -------------------------------------------------

# Gere NO SERVIDOR, nunca reaproveite a de desenvolvimento:
#   python3 -c "import os; print(os.urandom(32).hex())"
# app/__init__.py:40 recusa subir com chave de menos de 32 caracteres ou com um dos
# valores de exemplo. E a chave que assina os cookies de sessao: trocada, todo mundo
# e deslogado; vazada, qualquer um forja uma sessao de administrador.
SECRET_KEY=<64-caracteres-hexadecimais-gerados-no-servidor>

# Precisa ser a URL publica final, com https://.
#
# E daqui que saem os links dos e-mails de redefinicao de senha (app/api/web.py:237 e
# app/api/pais.py:656). Se ficar em branco, o padrao e http://localhost:8002 e os pais
# recebem um link que nao abre em lugar nenhum.
BASE_URL=https://<seu-dominio>


# --- Banco de dados -----------------------------------------------------------

# Postgres local do VPS, criado por deploy/postgres-setup.sh.
#
# Se a senha tiver @ : / ? # ou %, ela PRECISA vir percent-encoded aqui:
# app/core/database.py:44 separa os campos com urlparse(), e um "@" solto na senha
# faz o parser cortar a URL no lugar errado.
#   python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" 'senha'
#
# O sslmode NAO precisa (nem adianta) ser colocado na URL: database.py:53 fixa
# sslmode='require' no codigo e descarta a query string.
DATABASE_URL=postgresql://secureedu:<senha-percent-encoded>@localhost:5432/secureedu

# Conexoes por worker do gunicorn. O total contra o Postgres e DB_POOL_MAX x workers
# = 5 x 2 = 10, bem abaixo do max_connections padrao (100).
DB_POOL_MAX=5


# --- Rede e HTTPS -------------------------------------------------------------

# Porta em que o gunicorn escuta em 127.0.0.1. So o nginx alcanca.
PORT=8002

FLASK_DEBUG=false

# Redireciona http->https na propria aplicacao, alem do redirect do nginx, e faz o
# Flask-Talisman mandar HSTS. Depende de o nginx enviar X-Forwarded-Proto (esta em
# deploy/nginx-secureedu-proxy.conf) — sem isso, vira loop de redirecionamento.
FORCE_HTTPS=true

# true porque o nginx esta na frente: ProxyFix passa a ler o IP real do cliente em
# X-Forwarded-For, que e o que o rate limit de app/core/rate_limit.py contabiliza.
# So mantenha true enquanto o gunicorn estiver escutando em 127.0.0.1 (esta em
# deploy/gunicorn.conf.py). Exposto direto, isso deixaria qualquer um forjar o IP.
TRUST_PROXY=true


# --- E-mail (2FA dos pais e redefinicao de senha) -----------------------------

# Sem SMTP valido o portal dos pais nao funciona: o segundo fator e enviado por
# e-mail (app/api/pais.py:247) e nao ha outro caminho de entrada.
#
# Configuracao temporaria de homologacao com Gmail. SMTP_PASSWORD deve ser uma
# senha de app do Google, nunca a senha normal da conta. A conta precisa ter a
# verificacao em duas etapas ativada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=help.secureedu@gmail.com
SMTP_PASSWORD=<senha-de-app-digitada-diretamente-no-servidor>
SMTP_FROM=help.secureedu@gmail.com
SMTP_FROM_NAME=SecureEdu
SMTP_REPLY_TO=help.secureedu@gmail.com

# MANTENHA false. Em true, quando o envio de e-mail falha, o codigo 2FA e o link de
# redefinicao de senha sao gravados em texto puro no log (app/core/mailer.py:81). O
# log passaria a conter segundo fator valido e links de troca de senha prontos para
# uso — e ele e lido por mais gente do que a caixa de e-mail dos pais.
MAILER_FALLBACK_LOG=false


# --- Origem dos dados de aluno ------------------------------------------------

# Sem esta variavel a aplicacao se recusa a subir, de proposito
# (app/services/school_sql_directory.py:321): o padrao antigo era servir tres alunos
# de teste como se fossem o cadastro real da escola.
SCHOOL_SQL_MOCK=false

# ETAPA A — base provisoria em SQLite, com os 13 alunos de exemplo.
# Gere com: python escola_provisoria/seed.py
SCHOOL_SQL_ENGINE=sqlite
SCHOOL_SQL_DATABASE=/opt/secureedu/S2E_postgreSQL/escola_provisoria/escola.db
SCHOOL_SQL_HOST=
SCHOOL_SQL_PORT=
SCHOOL_SQL_USER=
SCHOOL_SQL_PASSWORD=

# ETAPA B — banco real da escola. Trocar as seis linhas acima por estas e reiniciar
# o servico. Exige a extensao unaccent habilitada no banco da escola, porque
# school_sql_directory.py:63 gera unaccent(lower(coluna)) na busca por nome.
# Se a escola expuser SQL Server ou Oracle em vez de Postgres, e preciso antes
# acrescentar o driver e um ramo em _conectar() (school_sql_directory.py:65).
#
# SCHOOL_SQL_ENGINE=postgres
# SCHOOL_SQL_DATABASE=<nome-do-banco>
# SCHOOL_SQL_HOST=<host>
# SCHOOL_SQL_PORT=5432
# SCHOOL_SQL_USER=<usuario-somente-leitura>
# SCHOOL_SQL_PASSWORD=<senha>

# Curto de proposito: se o banco da escola cair, a tela mostra o aluno sem foto ou a
# busca volta vazia, em vez de a requisicao inteira travar ate o timeout de TCP.
SCHOOL_SQL_TIMEOUT_SEG=5


# --- Retencao e manutencao (LGPD) ---------------------------------------------

# Rotina de expiracao em thread de fundo. Usa pg_try_advisory_xact_lock, entao nao
# duplica entre os dois workers nem com um cron externo.
MANUTENCAO_AUTOMATICA=true
MANUTENCAO_INTERVALO_SEG=600

# Dias que os registros de saida ficam guardados antes da limpeza.
MANUTENCAO_DIAS_RETENCAO=30

# A trilha de auditoria tem retencao propria, bem maior: e ela que responde "quem
# liberou este aluno, quando".
AUDITORIA_DIAS_RETENCAO=365


# --- Diversos -----------------------------------------------------------------

# Servidor e Postgres rodam em UTC; portaria e pais veem o relogio de Brasilia.
TIMEZONE=America/Sao_Paulo

# Caminho relativo e resolvido contra s2e-api/ (app/__init__.py:52). Guarda fotos
# legadas de aluno. Os anexos das saidas NAO ficam aqui: vao para a coluna BYTEA de
# saidas_documentos, no Postgres.
UPLOAD_FOLDER=storage

# 16 MB. Precisa casar com o client_max_body_size do nginx.
MAX_CONTENT_LENGTH=16777216

LOG_LEVEL=INFO


# --- Somente para o primeiro setup — APAGUE estas linhas depois ----------------
#
# Lidas apenas por setup_db.py, e so quando a tabela `usuarios` esta vazia.
# Depois de fazer o primeiro login e trocar a senha pela interface, remova as duas
# linhas: nao ha motivo para a senha inicial continuar em disco.
#
# Regra de senha (app/core/passwords.py): minimo 8 caracteres, com maiuscula,
# numero e caractere especial.
#
# INITIAL_ADMIN_PASSWORD=<senha-forte>
# INITIAL_ADMIN_EMAIL=<email-do-administrador>
